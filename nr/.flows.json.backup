    {
        "id": "9ab8824f679bcfce",
        "type": "sqlite",
        "z": "616b0fbf58fc4465",
        "g": "c2a55dc4385807f0",
        "mydb": "a074385e545da94b",
        "sqlquery": "msg.topic",
        "sql": "",
        "name": "查询relays",
        "x": 1130,
        "y": 2220,
        "wires": [
            [
                "963f7025c7c66bb5"
            ]
        ]
    },
    {
        "id": "c6f25f6b3271dbc6",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "c2a55dc4385807f0",
        "name": "查询所有的relays和config_indication_relays",
        "func": "msg.models = msg.payload;\nmsg.topic = ` SELECT *, 'action' AS type FROM config_relays\n  UNION ALL\n  SELECT *, 'indication' AS type FROM config_indication_relays\n  ORDER BY config_id, type, sort_order`;\n  return msg;\n// return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 2220,
        "wires": [
            [
                "9ab8824f679bcfce"
            ]
        ]
    },
    {
        "id": "963f7025c7c66bb5",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "c2a55dc4385807f0",
        "name": "封装数据",
        "func": "// const models = msg.models || [];\n// const allRelays = msg.payload || [];\n\n// const map = {};\n// allRelays.forEach(r => {\n//     if (!map[r.config_id]) map[r.config_id] = [];\n//     map[r.config_id].push({\n//         relay_name: r.relay_name,\n//         default_status: r.default_status,\n//         sort_order: r.sort_order\n//     });\n// });\n\n// msg.payload = models.map(m => {\n//     const { action_relays, ...rest } = m;\n//     return {\n//     ...rest,\n//     actionRelays:JSON.parse(m.action_relays),\n//     relaysNum:( map[m.id] || []).length,\n//     relays: map[m.id] || []\n//     }\n// });\n\n// return msg;\n\n  const models = msg.models || [];\n  const allRelays = msg.payload || [];\n\n  const actionMap = {};\n  const indicationMap = {};\n\n  allRelays.forEach(r => {\n      if (r.type === 'indication') {\n          if (!indicationMap[r.config_id]) indicationMap[r.config_id] = [];\n          indicationMap[r.config_id].push({\n              relay_name: r.relay_name,\n              default_status: r.default_status,\n              sort_order: r.sort_order\n          });\n      } else {\n          if (!actionMap[r.config_id]) actionMap[r.config_id] = [];\n          actionMap[r.config_id].push({\n              relay_name: r.relay_name,\n              default_status: r.default_status,\n              sort_order: r.sort_order\n          });\n      }\n  });\n\n  msg.payload = models.map(m => ({\n      ...m,\n      contact_13_closed: safeParse(m.contact_13_closed),\n      contact_24_closed: safeParse(m.contact_24_closed),\n      relaysNum: (actionMap[m.id] || []).length,\n      relays: actionMap[m.id] || [],\n      indicationRelays: indicationMap[m.id] || []\n  }));\n\n  function safeParse(v) {\n      if (!v) return {};\n      try { return JSON.parse(v); } catch { return {}; }\n  }\n\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1380,
        "y": 2220,
        "wires": [
            [
                "e0aed852096e366c"
            ]
        ]
    },
