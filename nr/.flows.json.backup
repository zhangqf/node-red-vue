    {
        "id": "dc213f5ba643a2f2",
        "type": "sqlite",
        "z": "616b0fbf58fc4465",
        "d": true,
        "g": "25117979b7b223cc",
        "mydb": "a074385e545da94b",
        "sqlquery": "fixed",
        "sql": "\n\nCREATE TABLE IF NOT EXISTS code_device (\n    id TEXT PRIMARY KEY NOT NULL,\n    name TEXT NOT NULL,\n    typeName TEXT NOT NULL,\n    combinationId TEXT NOT NULL,\n    configId TEXT NOT NULL,\n    location TEXT,\n    closeType TEXT,\n    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP\n);\n\n--   CREATE TABLE device_combination_bindings (\n--     device_id      TEXT NOT NULL,\n--     combination_id TEXT NOT NULL,\n--     PRIMARY KEY (device_id, combination_id),\n--     FOREIGN KEY (device_id)      REFERENCES device(id) ON DELETE CASCADE,\n--     FOREIGN KEY (combination_id) REFERENCES combinations(id)  ON DELETE CASCADE\n--   );\n",
        "name": "deviceDB",
        "x": 1380,
        "y": 5160,
        "wires": [
            []
        ]
    },
    {
        "id": "dfaf3f6d42bd59bc",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "25117979b7b223cc",
        "name": "查询config",
        "func": "const config = msg.req.body.config;\nconst typeName = msg.req.body.typeName || \"\";\nif(!config) {\n    return [\n        null,\n        { ...msg, payload: { code: 500, message: \"config 不能为空\" }, statusCode: 500 }\n    ];\n}\n\nconst safeType = typeName.replace(/'/g, \"''\");\nmsg.topic = `SELECT cfg.* FROM config cfg\nJOIN combination_config_bindings ccb ON ccb.config_id = cfg.id\nJOIN combination comb ON ccb.binding_id LIKE '%' || comb.id\nWHERE cfg.name='${config}' AND comb.deviceType='${safeType}'`;\nreturn [msg, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 5180,
        "wires": [
