    {
        "id": "484847c44846425c",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "模拟指令响应(切换机型/复位端子状态)",
        "func": "// 开发态 mock：直接回成功 cmdAck，模拟后端已响应前端指令。\n// 覆盖前端以「无 Modbus 读回」方式确认的两条指令：\n//   切换机型 = setDeviceType，复位端子状态 = relays 写线圈。\nconst type = msg.type;\nif (type !== \"setDeviceType\" && type !== \"relays\") return null;\n\nmsg.sendData = {\n    type: \"cmdAck\",\n    msgId: msg.msgId,\n    echoType: type,\n    ok: true,\n    value:msg.payload.value\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1830,
        "y": 740,
        "wires": [
            [
                "4b7f07f64670618a"
            ]
        ]
    },
    {
