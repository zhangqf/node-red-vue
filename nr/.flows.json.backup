            ]
        ]
    },
    {
        "id": "9674c411eedc5c42",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "f3bf070bfa71c273",
        "name": "设置设备类型",
        "func": "if (msg.payload.deviceType) {\n    flow.set(\"deviceType\", msg.payload.deviceType);\n}\n\nif (msg.error || msg.payload === \"\" || msg.payload === undefined) {\n    msg.sendData = { type: \"cmdAck\", msgId: msg.msgId, echoType: msg.type, ok: false,value:msg.payload.value };\n} else {\n    msg.sendData = { type: \"cmdAck\", msgId: msg.msgId, echoType: msg.type, ok: true, value: msg.payload.value };\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 500,
        "y": 1020,
        "wires": [
            [
                "265f22b555a87bec",
                "db395438428f9d29"
            ]
        ]
    },
    {
        "id": "c03f3aa268f70931",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "f3bf070bfa71c273",
        "name": "function 14",
        "func": "\n\n\n  msg.payload = {\n    \"fc\":3,\n    \"unitid\":4,\n    \"address\":4086,\n    \"quantity\":124,\n    \"value\": msg.value\n  };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 820,
        "wires": [
            []
        ]
    },
    {
        "id": "32dfce492af03749",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "45",
        "func": "const deviceType = flow.get(\"deviceType\") || \"\";\nconst isZYJ7orZDJ9 = deviceType === \"ZYJ7\" || deviceType === \"ZDJ9\";\n\nconst allDevices = [\n  { fc:3, unitid:5, address:4086, quantity:124, name:\"三相交流\" },\n  { fc:3, unitid:4, address:14, quantity:1, name:\"直流\" }\n];\n\nconst deviceList = allDevices.filter(d => {\n    if (isZYJ7orZDJ9 && d.unitid === 4) return false;\n    if (!isZYJ7orZDJ9 && d.unitid === 5) return false;\n    return true;\n});\n\nlet idx = context.get(\"idx2\") || 0;\nif (idx >= deviceList.length) idx = 0;\nconst dev = deviceList[idx];\nmsg.payload = {\n    fc: dev.fc,\n    unitid: dev.unitid,\n    address: dev.address,\n    quantity: dev.quantity\n};\nmsg.deviceName = dev.name;\nidx = idx + 1;\nif (idx >= deviceList.length) idx = 0;\ncontext.set(\"idx2\", idx);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 330,
        "y": 440,
        "wires": [
            [
                "c66233ceffdfb0f0",
                "3c0b7c3fc96efe16"
            ]
        ]
    },
    {
        "id": "86e8584270b91319",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "14d861217ea12ab5",
        "name": "封装数据",
        "func": "const data = msg.payload;\nconst relays = []\nconst indicationRelays = []\nif(data.length > 0) {\n    data.forEach(function(element) {\n        if(element.type === \"indication\") {\n            indicationRelays.push(element)\n        }\n        if(element.type === \"relays\")\n        {\n            relays.push(element)\n        }\n    });\n}\n\nmsg.payload = {\n    relays,\n    indicationRelays\n}\n// .relays = relays\n// msg.payload.indicationRelays = indicationRelays\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1380,
        "y": 3960,
        "wires": [
            [
                "16a0bc096e44300a"
            ]
        ]
    },
    {
        "id": "05bd591755f3fc47",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "交流采集模块 高位低位数据合并",
        "func": "// const data = msg.payload;\n\n// const mergeData = []\n\n// for(let index = 0; index < data.length; index++) {\n//     if(index%2) {\n//         const concatData = data[index-1] + \"\" + data[index]\n//         mergeData.push(Number(concatData))\n//     }\n//     // const element = array[index];\n    \n// } \n\nconst data = msg.payload;\nconst mergeData = [];\nif (Array.isArray(data)) {\n    data.reduce((prev, curr, idx) => {\n        if (idx % 2 === 1) mergeData.push(Number(prev + \"\" + curr));\n        return curr;\n    }, null);\n}\nmsg.sendData = {\n    type: \"ThreePhaseACCollector\",\n    value:mergeData\n};\n\n\nreturn msg;",
        "outputs": 1,
