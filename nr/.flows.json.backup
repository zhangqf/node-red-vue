        "func": "  // msg.models = msg.payload;\n\nconst configId = msg.req.params.configId;\n\n// msg.topic = ` SELECT *, 'relays' AS type FROM config_relays WHERE config_id = '${configId}'\n//   UNION ALL\n//   SELECT *, 'indication' AS type FROM config_indication_relays WHERE config_id = '${configId}'\n//   ORDER BY config_id, type, sort_order`;\n//   return msg;\n  msg.topic = `SELECT id, config_id, relay_name, default_status, sort_order, 'relays' AS type\n  FROM config_relays WHERE config_id = '${configId}'\n  UNION ALL\n  SELECT id, config_id, relay_name, default_status, sort_order, 'indication' AS type\n  FROM config_indication_relays WHERE config_id = '${configId}'\n  ORDER BY type, sort_order`;\n  return msg;\n  \n    \n\n  \n  \n  // const configId = msg.req.params.configId;\n  // msg.config = msg.payload[0] || {};\n  // msg.topic = `SELECT * FROM config_relays WHERE config_id = '${configId}' ORDER BY sort_order`;\n  // return msg;\n",
