        "func": "\nmsg.sendData = {\n    type: \"modbusStatus\",\n    connected: false,\n    msg: \"通讯异常：\" + (msg.error && msg.error.message ? msg.error.message : \"未知错误（未提供 msg.error）\"),\n    color: \"red\",\n    lastTime: new Date().toLocaleString()\n};\nreturn msg;",
