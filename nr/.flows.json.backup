    {
        "id": "4a182aa7e8bf13d8",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "heartbeat2",
        "func": "\nglobal.set(\"modbus2_last_tick\", Date.now());\nmsg.sendData = {\n    type: \"modbusStatus\",\n    connected: true,\n    msg: \"Modbus设备2通讯正常，正在收发数据\",\n    color: \"green\",\n    lastTime: new Date().toLocaleString(),\n    module: 2\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
