        "mydb": "a074385e545da94b",
        "sqlquery": "fixed",
        "sql": "  CREATE TABLE config_relays (\n    id            TEXT PRIMARY KEY,\n    config_id TEXT NOT NULL REFERENCES config(id) ON DELETE CASCADE,\n    relay_name    TEXT NOT NULL,         -- KA1, KA2, X1 ...\n    default_status INTEGER NOT NULL DEFAULT 0,  -- 1 / 0\n    sort_order    INTEGER DEFAULT 0,\n    UNIQUE(config_id, relay_name)\n  );\n",
        "name": "Config_relays",
        "x": 440,
