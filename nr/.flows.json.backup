        "z": "616b0fbf58fc4465",
        "g": "e55e445f6900b728",
        "name": "function 9",
        "func": "const now = new Date().toLocaleString();\n\nif (msg.error && msg.error.message.includes(\"SQLITE_ERROR:\")) {\n    const logText = `[${now}] SQL执行错误\n错误信息: ${msg.error.message}\n执行SQL: ${msg.topic}\n参数: ${JSON.stringify(msg.params ?? [])}\n--------------------------\\n`;\n    msg.payload = logText;\n}\n\n\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
