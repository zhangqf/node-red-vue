    {
        "id": "dce3b1cd8211f699",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d988c9e174ddf1e9",
        "name": "function 27",
        "func": "  const total = msg.payload[0]?.total || 0;\n\n  const page = parseInt(msg.req.query.page) || 1;\n  const pageSize = parseInt(msg.req.query.pageSize) || 15;\n  const offset = (page - 1) * pageSize;\n\n  const device = msg.req.query.device_name;\n  const combo = msg.req.query.combination_name;\n  const config = msg.req.query.config_name;\n  const opType = msg.req.query.op_type;\n  const status = msg.req.query.status;\n\n  const conditions = [];\n  const params = [];\n\n  if (device) conditions.push(`device_name LIKE '%${device}%'`);\n  if (combo) conditions.push(`combination_name LIKE '%${combo}%'`);\n  if (config) conditions.push(`config_name LIKE '%${config}%'`);\n  if (opType) {\n    conditions.push(`op_type = '${opType}'`);\n    params.push(opType);\n  }\n  if (status) {\n    conditions.push(`status = '${status}'`);\n    params.push(status);\n  }\n\n  const whereClause = conditions.length > 0 ? \"WHERE \" + conditions.join(\" AND \") : \"\";\n\n  msg.topic = `SELECT * FROM operation_records ${whereClause} ORDER BY created_at DESC LIMIT ${pageSize} OFFSET ${offset}`;\n  msg.params = params;\n  msg._total = total;\n\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
