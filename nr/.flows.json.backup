    },
    {
        "id": "cfef3057fe966387",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "1236",
        "func": "const deviceType = flow.get(\"deviceType\") || \"\";\nconst isZYJ7orZDJ9 = deviceType === \"ZYJ7\" || deviceType === \"ZDJ9\";\n\nconst devices = isZYJ7orZDJ9 ? { fc: 1, unitid: 2, address: 0, quantity: 32, name: \"ZYJ7\" } : { fc: 1, unitid: 1, address: 0, quantity: 32, name: \"ZD6\" };\n  \n  \n\nmsg.payload = {\n  fc: devices.fc,\n  unitid: devices.unitid,\n  address: devices.address,\n  quantity: devices.quantity\n};\nmsg.deviceName = devices.name;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 370,
