    {
        "id": "66eca866ade271ec",
        "type": "http in",
        "z": "616b0fbf58fc4465",
        "g": "d988c9e174ddf1e9",
        "name": "saveRecord",
        "url": "/saveRecord",
        "method": "post",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 210,
        "y": 4360,
        "wires": [
            [
                "2ad6f2af55cff0c0"
            ]
        ]
    },
    {
        "id": "2ad6f2af55cff0c0",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d988c9e174ddf1e9",
        "name": "写入JSON",
        "func": " const fs = global.get('fs');\n  const path = global.get('path');\nconst rootPath = flow.get('root')\n\n  const payload = msg.payload;\n\n  // 生成文件名\n  const now = new Date();\n  const month = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;\n  const timestamp =\n  `${month}-${String(now.getDate()).padStart(2,'0')}${String(now.getHours()).padStart(2,'0')}${String(now.getMinutes()).padStart(2,'0')}${String(now.getSeconds()).padStart(2,'0')}`;\n  \n   const safeDeviceName = payload.device_name.replace(/[ #]/g, '-');\n  const fileName = `${timestamp}-${payload.op_type}-${safeDeviceName}.json`;\n  // const fileName = `${timestamp}-${payload.op_type}-${payload.device_name}.json`;\n\n  // 目录：records/2025-01/\n  const dir = path.join(rootPath, 'data','records', month);\n  node.log(dir);\n  if (!fs.existsSync(dir)) {\n      fs.mkdirSync(dir, { recursive: true });\n  }\n\n  const data = {\n    data:payload.curve_data,\n    time:payload.time_data\n  }\n\n  // 如果存在功率数据，也写入\n  if (payload.phasePower && payload.phasePower.length) {\n    data.phasePower = payload.phasePower;\n    data.power_time = payload.power_time;\n  }\n\n  // 操作日志一并归档\n  if (payload.operationLog && payload.operationLog.length) {\n    data.operationLog = payload.operationLog;\n  }\n\n  // 前端已综合表示继电器 + 电流曲线 + 功率曲线判定，这里直接采用\n  payload.status = payload.status || \"success\"\n\n  // 写曲线数据\n  const filePath = path.join(dir, fileName);\n  fs.writeFileSync(filePath, JSON.stringify(data, null, 2));\n\n  // 把路径和参数传给下一个节点\n  msg.curve_file = path.join('records', month, fileName);\n  msg.params = [\n      payload.device_name,\n      payload.combination_name,\n      payload.config_name,\n      payload.op_type,\n      payload.status,\n      payload.peak_current,\n      payload.valley_current,\n      msg.curve_file,\n      JSON.stringify(payload.result),\n      JSON.stringify(payload.pre_test || null),\n      payload.fail_reason || \"\",\n  ];\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 510,
        "y": 4360,
        "wires": [
            [
                "ccb9a63440cb0fea"
            ]
        ]
    },
    {
        "id": "ccb9a63440cb0fea",
