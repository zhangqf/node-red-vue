    {
        "id": "634b0366e748a6c4",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d988c9e174ddf1e9",
        "name": "function 20",
        "func": "const page = parseInt(msg.req.query.page) || 1;\n  const pageSize = parseInt(msg.req.query.pageSize) || 15;\n  const offset = (page - 1) * pageSize;\n\n  const device = msg.req.query.device_name;\n  const combo = msg.req.query.combination_name;\n  const config = msg.req.query.config_name;\n  const opType = msg.req.query.op_type;\n  const status = msg.req.query.status;\n\n  // 构建搜索条件\n  const conditions = [];\n  const params = [];\n\n  if (device) {\n    conditions.push(`device_name LIKE '%${device}%'`);   // 直接拼 SQL\n  }\n  if (combo) {\n    conditions.push(`combination_name LIKE '%${combo}%'`);\n  }\n  if (config) {\n    conditions.push(`config_name LIKE '%${config}%'`);\n  }\n  if (opType) {\n    conditions.push(`op_type = '${opType}'`);\n    // params.push(opType);\n  }\n  if (status) {\n    conditions.push(`status = '${status}'`);\n    params.push(status);\n  }\n\n  const whereClause = conditions.length > 0 ? \"WHERE \" + conditions.join(\" AND \") : \"\";\n\n  msg.topic = `SELECT COUNT(*) as total FROM operation_records ${whereClause}`;\n  msg.params = params;\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
