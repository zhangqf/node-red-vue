        "name": "handleAdd",
        "func": "// const fs = global.get('fs')\n// const path = global.get('path')\n// const crypto = global.get('crypto')\n// const root = global.get('rootPath');\n// const filePath = path.join(root, 'device')\n\n\n\nmsg.payload.id = msg.uuid\n\n\n// const dir = path.dirname(filePath);\n\n// // 当前传入的设备数据\n// const newItem = msg.payload;\n\n// async function saveDevice() {\n//     try {\n//         debugger;\n//         // 1. 目录不存在自动创建\n//         if (!fs.existsSync(dir)) {\n//             fs.mkdirSync(dir, { recursive: true });\n//         }\n\n//         let deviceList = [];\n//         // 2. 文件存在则读取原有数据\n//         if (fs.existsSync(filePath)) {\n//             const fileText = await fs.promises.readFile(filePath, \"utf8\");\n//             node.info(fileText)\n//             // 防止文件为空报错\n//             if (fileText.trim()) {\n//                 deviceList = JSON.parse(fileText);\n//             }\n//         }\n\n//         // 3. 根据id查找，更新/新增设备\n//         const targetId = newItem.data.id;\n//         let hasExist = false;\n//         for (let i = 0; i < deviceList.length; i++) {\n//             if (deviceList[i].data.id === targetId) {\n//                 deviceList[i] = newItem;\n//                 hasExist = true;\n//                 break;\n//             }\n//         }\n//         if (!hasExist) {\n//             deviceList.push(newItem);\n//         }\n\n//         // 4. 格式化写入，美化换行，方便查看\n//         const saveText = JSON.stringify(deviceList, null, 2);\n//         await fs.promises.writeFile(filePath, saveText, \"utf8\");\n\n//         node.warn(\"设备数据持久化完成\");\n//         msg.deviceList = deviceList;\n//     } catch (err) {\n//         node.error(\"持久化失败\", err.stack);\n//         console.error(err);\n//     }\n//     return msg;\n// }\n\n// saveDevice();\n\n\n\n// try {\n//     const dir = path.dirname(filePath);\n//     if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });\n//         const line = `[${new Date().toLocaleString()}] ${msg.payload.data}\\n`;\n//         await fs.promises.appendFile(filePath, line, \"utf8\");\n// } catch (error) {\n//     msg.error = error.message;\n// };\n\nmsg.params = {\n    $id: msg.payload.id,\n    $name: msg.payload.name,\n    $typeName: msg.payload.typeName,\n    $location: msg.payload.location\n}\n\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
