        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "device_combination_bindings",
        "func": "// const deviceid= msg.req.params.deviceId\n\n// msg.topic = `SELECT * FROM device_combination_bindings WHERE device_id = '${deviceid}'`;\n// // msg.params=[msg.req.params.deviceId]\n//   return msg;\n\n\n  msg.topic = \"SELECT * FROM device_combination_bindings\";\n  return msg;",
        "outputs": 1,
        "timeout": 0,
