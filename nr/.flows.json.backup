    {
        "id": "b87c839122f3a5e7",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "heartbeat",
        "func": "\nglobal.set(\"modbus_last_tick\", Date.now());\nmsg.sendData = {\n    type: \"modbusStatus\",\n    connected: true,\n    msg: \"Modbus设备通讯正常，正在收发数据\",\n    color: \"green\",\n    lastTime: new Date().toLocaleString()\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 820,
        "y": 60,
        "wires": [
            []
        ]
    },
    {
        "id": "e6b2dbbdb7af7639",
        "type": "inject",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "",
        "props": [
            {
                "p": "payload"
            },
            {
                "p": "topic",
                "vt": "str"
            }
        ],
        "repeat": "1",
        "crontab": "",
        "once": false,
        "onceDelay": 0.1,
        "topic": "",
        "payload": "",
        "payloadType": "date",
        "x": 1080,
        "y": 60,
        "wires": [
            [
                "f54fb098cd2a9dd6"
            ]
        ]
    },
    {
        "id": "f54fb098cd2a9dd6",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "func_check_timeout",
        "func": "\nconst lastTick = global.get(\"modbus_last_tick\") || 0;\nconst now = Date.now();\nconst timeout = 1000;\n\nlet sendData = {};\n\n// 情况1：从未收到过任何数据（完全没连上）\nif (lastTick === 0) {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: true,\n        msg: \"未建立Modbus连接，无任何数据返回\",\n        color: \"orange\",\n        lastTime: \"--\"\n    };\n}\n// 情况2：3秒内有数据，在线\nelse if (now - lastTick < timeout) {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: true,\n        msg: \"通讯正常\",\n        color: \"green\",\n        lastTime: new Date(lastTick).toLocaleString()\n    };\n}\n// 情况3：超过3秒无新数据，设备断开（flex-getter无输出）\nelse {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: true,\n        msg: \"Modbus通讯中断，设备无应答\",\n        color: \"red\",\n        lastTime: new Date(lastTick).toLocaleString()\n    };\n}\n\nmsg.sendData = sendData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1360,
        "y": 80,
        "wires": [
            [
                "265f22b555a87bec"
            ]
        ]
    },
