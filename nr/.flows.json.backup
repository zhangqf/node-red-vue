        "g": "d988c9e174ddf1e9",
        "mydb": "a074385e545da94b",
        "sqlquery": "prepared",
        "sql": "  INSERT INTO operation_records\n    (device_name, combination_name, config_name, op_type, status, peak_current, valley_current, curve_file,result,pre_test,fail_reason)\n  VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)",
