    },
    {
        "id": "4bf575d7fcd07222",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "combination_config_bindings",
        "func": "\n msg.bindings = msg.payload;\n  msg.topic = \"SELECT * FROM combination_config_bindings\";\n  return msg;\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
