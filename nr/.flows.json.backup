    {
        "id": "b48e96224574ad65",
        "type": "sqlite",
        "z": "616b0fbf58fc4465",
        "d": true,
        "g": "d87b7462d5d25eab",
        "mydb": "a074385e545da94b",
        "sqlquery": "fixed",
        "sql": "  CREATE TABLE combination_config_bindings (\n    binding_id      TEXT NOT NULL,   -- device_id + combination_id 联合标识\n    config_id   TEXT NOT NULL,\n    PRIMARY KEY (binding_id, config_id),\n    FOREIGN KEY (config_id) REFERENCES config(id) ON DELETE CASCADE\n  );\n",
        "name": "combinationConfigBindings",
        "x": 480,
        "y": 3080,
        "wires": [
            []
        ]
    },
    {
        "id": "b582a66069a285c6",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "function 10",
        "func": " const data = msg.req.body;\n  const deviceId = data.deviceId;\n  const bindings = data.bindings || [];\n\n  let sql = \"\";\n\n  // 1. 清旧数据\n  sql += `DELETE FROM device_combination_bindings WHERE device_id = '${deviceId}';\\n`;\n  sql += `DELETE FROM combination_config_bindings WHERE binding_id LIKE '${deviceId}\\\\_%' ESCAPE '\\\\';\\n`;\n\n  // 2. 写新数据\n  bindings.forEach(b => {\n      sql += `INSERT OR REPLACE INTO device_combination_bindings (device_id, combination_id) VALUES ('${deviceId}', '${b.combinationId}');\\n`;\n\n      b.configIds.forEach(cid => {\n          sql += `INSERT OR REPLACE INTO combination_config_bindings (binding_id, config_id) VALUES ('${deviceId}_${b.combinationId}', '${cid}');\\n`;\n      });\n  });\n\n  msg.topic = sql;\n  msg.payloadOut = { code: 200, message: \"保存成功\" };\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 590,
        "y": 2780,
