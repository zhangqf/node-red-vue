        "g": "d988c9e174ddf1e9",
        "name": "function 22",
        "func": "const fs = global.get('fs');\nconst path = global.get('path');\nconst rootPath = flow.get('root');\n\nnode.log(path);\n\nconst fileName = msg.req.body.filename\n\nconst filePath =path.join(rootPath, \"data\", fileName)\n\ntry {\n    // 先判断文件是否存在\n    if (fs.existsSync(filePath)) {\n        fs.unlinkSync(filePath);\n        msg.payload = { code: 200, msg: \"文件删除成功\" };\n    } else {\n        // 文件本来就不存在，直接返回成功，不抛错\n        msg.payload = { code: 200, msg: \"文件不存在，无需删除\" };\n    }\n} catch (err) {\n    msg.payload = { code: 500, msg: \"删除失败\", error: err.message };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
