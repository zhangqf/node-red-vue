        "name": "查询combination",
        "func": "msg.config = msg.payload[0]\nconst combination = msg.req.body.combination;\n\nif(!combination) throw Error(\"config 不能为空\")\n\nconst typeName = (msg.req.body.typeName || \"\").replace(/'/g, \"''\");\nmsg.topic = `SELECT * FROM combination WHERE name='${combination}' AND deviceType='${typeName}'`\nreturn msg;",
        "outputs": 1,
