    {
        "id": "11924bd627085375",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "c2a55dc4385807f0",
        "name": "handleUpdate",
        "func": " const data = msg.req.body;\n const cid = data.id || msg.uuid || Date.now().toString();\n\nconst relayList = data.relays || [];\n\n\nconst indicationRelays = data.indicationRelays || []\nconst contact_13_closed = JSON.stringify(data.contact_13_closed);\nconst contact_24_closed = JSON.stringify(data.contact_24_closed);\n\n\n\n  let sql = `DELETE FROM config_relays WHERE config_id = '${cid}';\\n`;\n   sql += `DELETE FROM config_indication_relays WHERE config_id = '${cid}';\\n`;\nsql += `INSERT OR REPLACE INTO config (id, name, description,contact_13_closed,contact_24_closed) VALUES ('${cid}', '${(data.name ?? \"\").replace(/'/g, \"''\")}', '${(data.description ?? \"\").replace(/'/g, \"''\")}','${contact_13_closed}','${contact_24_closed}');\\n`;\n\n  relayList.forEach(r => {\n      sql += `INSERT OR REPLACE INTO config_relays (id, config_id, relay_name, default_status, sort_order)\n  VALUES ('${cid}_${r.relay_name}', '${cid}', '${r.relay_name}', ${r.default_status}, ${r.sort_order});\\n`;\n  });\n\n  indicationRelays.forEach(r => {\n      sql += `INSERT OR REPLACE INTO config_indication_relays (id, config_id, relay_name, default_status, sort_order)\n  VALUES ('${cid}_${r.relay_name}', '${cid}', '${r.relay_name}', ${r.default_status}, ${r.sort_order});\\n`;\n  });\n\n  msg.topic = sql;\n  msg.payloadOut = { code: 200, message: \"保存成功\" };\n  return msg;\n\n\n// msg.params = {\n//     $id: msg.payload.id,\n//     $name: msg.payload.name,\n//     $description: msg.payload.description,\n// }\n\n\n\n// return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1000,
        "y": 2080,
        "wires": [
            [
                "fdb7b75e29fa54bd"
            ]
        ]
    },
