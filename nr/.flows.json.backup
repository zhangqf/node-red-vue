        "g": "d988c9e174ddf1e9",
        "name": "function 13",
        "func": "const fs = global.get('fs');\n  const path = global.get('path');\n  const rootPath = flow.get('root')\n\n  const rawPath = decodeURIComponent(msg.req.path);\n  const filePath = path.join(rootPath, 'data', rawPath);\n  if (fs.existsSync(filePath)) {\n      const raw = fs.readFileSync(filePath, 'utf8');\n      msg.payload = JSON.parse(raw);\n  } else {\n      msg.statusCode = 404;\n      msg.payload = {};\n  }\n  return msg;",
