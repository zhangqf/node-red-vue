    {
        "id": "9f86ad594866911b",
        "type": "sqlite",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "mydb": "a074385e545da94b",
        "sqlquery": "msg.topic",
        "sql": "\n\nSELECT * FROM config ORDER BY updated_at DESC",
        "name": "获取config",
        "x": 1210,
        "y": 2880,
        "wires": [
            [
                "7f629c89cc5c8809"
            ]
        ]
    },
    {
        "id": "7f629c89cc5c8809",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "merge",
        "func": "  const bindings = msg.bindings || [];\n  const configBindings = msg.payload || [];\n\n  // 按 deviceId 分组\n  const map = {};\n  bindings.forEach(b => {\n      const key = `${b.device_id}_${b.combination_id}`;\n      if (!map[b.device_id]) map[b.device_id] = {};\n      map[b.device_id][b.combination_id] = [];\n  });\n\n  // 填入 configIds\n  configBindings.forEach(cb => {\n      const parts = cb.binding_id.split('_');\n      const deviceId = parts[0];\n      const combinationId = parts.slice(1).join('_'); // 兼容 UUID 可能带下划线\n      if (map[deviceId] && map[deviceId][combinationId] !== undefined) {\n          map[deviceId][combinationId].push(cb.config_id);\n      }\n  });\n  const deviceRaw = msg.req.params.deviceId;\n\n  msg.payload = Object.entries(map).map(([deviceId, combos]) => ({\n      deviceId,\n      bindings: Object.entries(combos).map(([combinationId, configIds]) => ({\n          deviceId,\n          combinationId,\n          configIds\n      }))\n  }));\n\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1390,
        "y": 2880,
        "wires": [
            [
                "137ef5970207c66e"
            ]
        ]
    },
    {
        "id": "64bbfa24ee5d7720",
        "type": "http in",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "getConfigsByBinding",
        "url": "/getConfigsByBinding/:deviceId/:combinationId",
        "method": "get",
        "upload": false,
        "skipBodyParsing": false,
        "swaggerDoc": "",
        "x": 200,
        "y": 2960,
        "wires": [
            [
                "cf2d927fe58e2996"
            ]
        ]
    },
    {
        "id": "cf2d927fe58e2996",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d87b7462d5d25eab",
        "name": "function 12",
        "func": "// const devideId = msg.req.params.deviceId\n// const combinationId = msg.req.params.combinationId\n\n// msg.topic = `SELECT config_id FROM combination_config-bindings\n// JOIN config cfg ON cfg.id = \n// WHERE binding_id = \"${devideId}_${combinationId}\"\n// `\n\n\nconst deviceId = msg.req.params.deviceId;\nconst combinationId = msg.req.params.combinationId;\nconst bindId = `${deviceId}_${combinationId}`;\n\n\nmsg.topic = `SELECT cfg.* \n  FROM \"combination_config_bindings\" comb\n  JOIN config cfg ON comb.config_id = cfg.id\n  WHERE comb.binding_id = \"${bindId}\"`;\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
