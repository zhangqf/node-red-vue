        ]
    },
    {
        "id": "5256708a666c89fa",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "f3bf070bfa71c273",
        "name": "function 30",
        "func": "\n const DC = [\n      [19,20,21],\n      [13,14,15,16,17,18],\n      [31]\n ]\n\n const AC = [\n     [23,24,25,26,27],\n     [5,6,7,8,9,10,11,12],\n     [31]\n ]\n\n/**\n * 互锁校验函数\n * @param {number[]} arr 输入的0/1数组\n * @returns { {ok: boolean, activeGroups: number[], msg: string} }\n */\nfunction checkInterlock(arr,unitId) {\n  // 收集触发的组\n  const activeGroups = [];\n  let groups = []\n  if(unitId === 1) {\n    groups = DC\n    }\n    if(unitId === 2) {\n    groups = AC\n    }\n  groups.forEach((indexList, groupNo) => {\n    // 本组任意一个下标值等于1 → 本组触发\n    const isTrigger = indexList.some(idx => arr[idx] === 1);\n    if (isTrigger) {\n      activeGroups.push(groupNo + 1); // 组号 1/2/3\n    }\n  });\n\n  const ok = activeGroups.length <= 1;\n  let msginfo = ok ? \"校验通过\" : `互锁冲突！同时触发组：${activeGroups.join(',')}`;\n  return { ok, activeGroups, msginfo };\n}\n\n\nconst unitId = msg.payload.deviceType === \"ZD6\" || msg.payload.deviceType === \"ZD9\" ? 1 : 2\n\nconst { ok, activeGroups, msginfo} = checkInterlock(msg.payload.value,unitId)\n\nconsole.info(ok)\nnode.log(ok);\n\n\n\nif(ok) {\n    return msg;\n} else {\n    return false;\n}\n\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 4,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 490,
        "y": 760,
        "wires": [
            [
                "775fac645c87ae36"
            ]
        ]
    },
    {
        "id": "5005fe1958d4203b",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "function 31",
        "func": " const data = msg;\n    msg.payload[0] = msg.payload[0] / 100.0\n    msg.sendData = {\n    data:msg.payload,\n    module:'‌DCCurrentSampling',\n    type:\"modbusRealData\",\n    unitId: data.modbusRequest.unitid,\n\tfc: data.modbusRequest.fc,\n\taddress:data.modbusRequest.address,\n\tquantity: data.modbusRequest.quantity,\n    }\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 260,
        "wires": [
            [
                "265f22b555a87bec"
            ]
        ]
    },
    {
        "id": "a02171a9edde8434",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "function 32",
        "func": "const data = msg.payload;\n    const mergeData = [];\n    if (Array.isArray(data)) {\n    data.reduce((prev, curr, idx) => {\n        if (idx % 2 === 1) mergeData.push(Number(prev + \"\" + curr));\n        return curr;\n    }, null);\n    }\n    msg.sendData = {\n    type: \"ThreePhaseACCollector\",\n    value:mergeData\n    };\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 830,
        "y": 340,
        "wires": [
            [
                "265f22b555a87bec"
            ]
        ]
    },
