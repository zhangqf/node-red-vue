    {
        "id": "e1ef421a2fcabe82",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d988c9e174ddf1e9",
        "name": "function 26",
        "func": "  msg.payload = {\n    data: msg.payload || [],\n    total: msg._total || 0,\n  };\n  return msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
