    {
        "id": "878bcbad88c1bdaa",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "32路继电器",
        "func": "\n// 开发态 mock：回显最近一次写入该 unitId 的线圈值\nconst unitid = (flow.get(\"deviceType\") === \"ZD6\" || flow.get(\"deviceType\") === \"ZD9\") ? 1 : 2;\nlet last = flow.get(\"coilWrite_\" + unitid);\nif (!Array.isArray(last)) {\n    // 尚无写入时，保留原有固定模拟值\n    last = new Array(32).fill(0);\n    last[0] = 1; last[3] = 1; last[4] = 1; last[5] = 1; last[6] = 1; last[7] = 1;\n}\nconst data32 = new Array(32).fill(0);\nfor (let i = 0; i < last.length && i < 32; i++) data32[i] = last[i] ? 1 : 0;\n\n// data32[18] = 1\n\nmsg.sendData = {\n    data: data32,\n    type: \"modbusRealData\",\n    unitId: unitid,\n    fc: 3,\n    address: 1,\n    quantity: 32,\n};\n\nreturn msg",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1930,
        "y": 460,
        "wires": [
            [
                "4b7f07f64670618a"
            ]
        ]
    },
    {
        "id": "044490c99bf70496",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "f3bf070bfa71c273",
        "name": "写应答(真·Modbus)",
        "func": "// modbus-flex-write 输出：成功=设备已应答FC15写入；失败(emptyMsgOnFail)=空/带error\nif (msg.error || msg.payload === \"\" || msg.payload === undefined) {\n    msg.sendData = { type: \"cmdAck\", msgId: msg.msgId, echoType: msg.type, ok: false,value:msg.payload.value };\n} else {\n    msg.sendData = { type: \"cmdAck\", msgId: msg.msgId, echoType: msg.type, ok: true ,value:msg.payload.value};\n}\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1350,
        "y": 780,
        "wires": [
            [
                "265f22b555a87bec"
            ]
        ]
    },
