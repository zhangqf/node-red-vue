        "sqlquery": "fixed",
        "sql": "  CREATE TABLE device_combination_bindings (\n    device_id      TEXT NOT NULL,\n    combination_id TEXT NOT NULL,\n    PRIMARY KEY (device_id, combination_id),\n    FOREIGN KEY (device_id)      REFERENCES device(id) ON DELETE CASCADE,\n    FOREIGN KEY (combination_id) REFERENCES combinations(id)  ON DELETE CASCADE\n  );\n",
        "name": "deviceCombinationBindings",
        "x": 480,
        "y": 3040,
        "wires": [
            []
        ]
    },
    {
        "id": "7e4e4a6d449417b7",
