        "func": "// const fs = global.get('fs')\n// const path = global.get('path')\n// const crypto = global.get('crypto')\n// const root = global.get('rootPath');\n// const filePath = path.join(root, 'device')\n\n\n// try {\n//     let list = []\n//     if(fs.existsSync(filePath)){\n//         const raw = fs.readFileSync(filePath, \"utf8\")\n//         list = JSON.parse(raw)\n//         console.log(typeof list)\n//     }\n//     const targetId = msg.payload.id\n//     console.log(list)\n//     const index = list.findIndex(item => item.id === targetId)\n//     if(index > -1) {\n//         list[index] =msg.payload\n//     }\n//     fs.writeFileSync(filePath,JSON.stringify(list, null, 2), 'utf8')\n//     msg.result = '更新成功'\n// } catch (error) {\n//     msg.error = error.message;\n// };\n\n\nmsg.params = {\n    $id: msg.payload.id,\n    $name: msg.payload.name,\n    $typeName: msg.payload.typeName,\n    $location: msg.payload.location\n}\n\n\n\nreturn msg;",
