    {
        "id": "5c7e881cbf8274e4",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "14d861217ea12ab5",
        "name": "处理数据",
        "func": "const m = msg.payload[0] || {};\n\n// 判断是否为空对象\nif (Object.keys(m).length === 0) {\n  msg.payload = {};\n} else {\n  // 剔除 action_relays 字段，并转换字段\n  const { action_relays, contact_13_closed, contact_24_closed, ...rest } = m;\n  // let actionRelays = [];\n  let contact13Closed = []\n  let contact24Closed = []\n  try {\n    // if (action_relays) actionRelays = JSON.parse(action_relays);\n    if (contact_13_closed) contact13Closed = JSON.parse(contact_13_closed);\n    if (contact_24_closed) contact24Closed = JSON.parse(contact_24_closed);\n  } catch (err) {\n    // actionRelays = [];\n    contact13Closed = [];\n     contact24Closed = [];\n  }\n  msg.payload = {\n    ...rest,\n    contact13Closed,\n    contact24Closed\n  };\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1360,
        "y": 4040,
