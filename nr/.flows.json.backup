    {
        "id": "775fac645c87ae36",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "f3bf070bfa71c273",
        "name": "relays",
        "func": "// 取出前端传来的线圈数组\nconst coilArr = msg.payload.value || [];\n// 初始化32个0的数组\nconst rawData = new Array(32).fill(0);\n// 从下标0开始，覆盖对应长度，剩余保持0\nrawData.splice(0, coilArr.length, ...coilArr);\n\nconst unitId = msg.payload.deviceType === \"ZD6\" || msg.payload.deviceType === \"ZD9\" ? 1 : 2\n\n// msg.payload = {\n//   \"fc\":1,\n//     \"unitid\":2,\n//     \"address\":0,\n//     \"quantity\":32,\n//     \"name\":\"继电器状态\",\n//   \"value\": msg.value\n// };\n\n \n\n  msg.payload = {\n    \"fc\":15,\n    \"unitid\":unitId,\n    \"address\":0,\n    \"quantity\":32,\n    \"value\": rawData\n  };\nflow.set(\"coilWrite_\" + unitId, rawData);\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 650,
        "y": 760,
        "wires": [
            [
                "c864b2b04012c0b8",
                "8ae3c62d5b7b688f"
            ]
        ]
    },
    {
        "id": "e728fd8a8e79ab1a",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "d4daa8ea2a409763",
        "name": "judgeUpdateOrAdd",
        "func": "if (!msg.payload || typeof msg.payload !== 'object' || Object.keys(msg.payload).length === 0) {\n    throw new Error(\"接收到的数据为空或格式不正确，请检查请求体\");\n}\n\nif(msg.payload.id){\n    msg.requestType = \"update\"\n} else {\n    msg.requestType = \"add\"\n}\n\n\n\n\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 410,
        "y": 1200,
        "wires": [
            [
                "eef041636012ea20"
            ]
        ]
    },
