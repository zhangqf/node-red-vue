        ]
    },
    {
        "id": "63bbb8f0b5580c9b",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "error2",
        "func": "\nmsg.sendData = {\n    type: \"modbusStatus\",\n    connected: false,\n    msg: \"通讯异常2：\" + msg.error.message,\n    color: \"red\",\n    lastTime: new Date().toLocaleString(),\n    module: 2\n};\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 750,
        "y": 520,
        "wires": [
            []
        ]
    },
    {
        "id": "a7ea1f611926bfe8",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "a26209f8a1380253",
        "name": "func_check_timeout2",
        "func": "const lastTick = global.get(\"modbus2_last_tick\") || 0;\nconst now = Date.now();\nconst timeout = 1000;\n\nlet sendData = {};\n\n// 情况1：从未收到过任何数据（完全没连上）\nif (lastTick === 0) {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: true,\n        msg: \"未建立Modbus2连接，无任何数据返回\",\n        color: \"orange\",\n        lastTime: \"--\",\n        module: 2\n    };\n}\n// 情况2：3秒内有数据，在线\nelse if (now - lastTick < timeout) {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: true,\n        msg: \"Modbus2通讯正常\",\n        color: \"green\",\n        lastTime: new Date(lastTick).toLocaleString(),\n        module: 2\n    };\n}\n// 情况3：超过3秒无新数据，设备断开（flex-getter无输出）\nelse {\n    sendData = {\n        type: \"modbusStatus\",\n        connected: false,\n        msg: \"Modbus2通讯中断，设备无应答\",\n        color: \"red\",\n        lastTime: new Date(lastTick).toLocaleString(),\n        module: 2\n    };\n}\n\nmsg.sendData = sendData;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1300,
        "y": 120,
        "wires": [
            [
                "265f22b555a87bec"
            ]
        ]
    },
