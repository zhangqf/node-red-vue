        "name": "根据deviceID和combinationID 查询config",
        "func": "const deviceId = msg.req.params.deviceId;\nconst combinationId = msg.req.params.combinationId;\n\n\n  msg.topic = `SELECT cfg.* FROM config cfg\n  JOIN combination_config_bindings ccb ON cfg.id = ccb.config_id\n  WHERE ccb.binding_id = '${deviceId}_${combinationId}'`;\n  return msg;\n\n  // msg.topic = `SELECT c.* FROM combination c\n  // JOIN device_combination_bindings dcb ON c.id = dcb.combination_id\n  // WHERE dcb.device_id = $deviceId`;\n\n  // msg.payload = [deviceId];  \n  // return msg;\n\n",
