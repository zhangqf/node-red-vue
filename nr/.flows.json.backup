    {
        "id": "f8385d18a19492fc",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "function 29",
        "func": "const data = msg;\nmsg.sendData = {\n    data:msg.payload,\n    type:\"modbusRealData\",\n    module:'variableFrequencyDrive',\n    unitId: data.modbusRequest.unitid,\n\tfc: data.modbusRequest.fc,\n\taddress:data.modbusRequest.address,\n\tquantity: data.modbusRequest.quantity,\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
