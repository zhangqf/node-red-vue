        "g": "25117979b7b223cc",
        "name": "handleAdd",
        "func": "\nconst config = msg.config\nconst combination = msg.combination\nconst data = msg.req.body\n\nmsg.params = {\n    $id: msg.uuid,\n    $name: data.name,\n    $typeName: data.typeName,\n    $location: data.location,\n    $configId:config.id,\n    $combinationId:combination.id,\n    $closeType: data.closeType || \"\"\n}\n\n\nreturn msg;",
        "outputs": 1,
