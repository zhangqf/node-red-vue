        "g": "25117979b7b223cc",
        "mydb": "a074385e545da94b",
        "sqlquery": "prepared",
        "sql": "INSERT OR REPLACE INTO code_device (id, name,typeName, location,configId,combinationId,closeType) VALUES ($id, $name, $typeName,$location, $configId,$combinationId,$closeType)\n\n",
        "name": "deviceDB",
        "x": 1480,
