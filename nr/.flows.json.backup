        "func": "const data = msg.req.body || {};\nif (!data.id || !data.closeType) {\n    msg.statusCode = 400;\n    msg.payload = { code: 400, message: 'id 或 closeType 不能为空' };\n    return [null, msg];\n}\nmsg.params = {\n    $id: data.id,\n    $closeType: data.closeType\n};\nreturn [msg, null];",
