    {
        "id": "5a667f770032dbf2",
        "type": "function",
        "z": "616b0fbf58fc4465",
        "g": "1f78b039e01e6dfa",
        "name": "function 3",
        "func": "\n\n\n\nlet sendData = {};\n\n\n\nif(msg.modbusRequest.unitid=== 4) {\n    const data = msg;\n    msg.payload[0] = msg.payload[0] / 100.0\n    msg.sendData = {\n    data:msg.payload,\n    type:\"modbusRealData\",\n    unitId: data.modbusRequest.unitid,\n\tfc: data.modbusRequest.fc,\n\taddress:data.modbusRequest.address,\n\tquantity: data.modbusRequest.quantity,\n    }\n}\n\n\nif(msg.modbusRequest.unitid=== 5) {\n    const data = msg.payload;\n    const mergeData = [];\n    if (Array.isArray(data)) {\n    data.reduce((prev, curr, idx) => {\n        if (idx % 2 === 1) mergeData.push(Number(prev + \"\" + curr));\n        return curr;\n    }, null);\n    }\n    msg.sendData = {\n    type: \"ThreePhaseACCollector\",\n    value:mergeData\n    };\n}\n\nreturn msg;\n\n\n\nreturn msg;\n\n",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 960,
        "y": 400,
